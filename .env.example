# ==== 1. 自律リサーチ機能 ====
# Tavily Search API キー (https://app.tavily.com/ で取得)
TAVILY_API_KEY=your_tavily_api_key_here

# Ollamaの接続先とモデル名 (Qwen系モデルを想定。事前に `ollama pull qwen2.5` 等でpull済みであること)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# 睡眠モード・夜間修行・自律討論・青空文庫クロールなど、応答速度が問題にならない
# 夜間バックグラウンド処理専用のローカルモデル。USE_GROQ=trueでもこれらは常に
# ローカルOllamaを使い、Groq無料枠のTPD消費をチャット用に温存する
LOCAL_BACKGROUND_MODEL=qwen3:14b

# ==== 2. 議事録作成機能 ====
# pyannote.audio の話者分離モデル利用に必要なHuggingFaceアクセストークン
# https://huggingface.co/settings/tokens で発行し、
# pyannote/speaker-diarization-3.1 と pyannote/segmentation-3.0 の利用規約に同意しておくこと
HUGGINGFACE_TOKEN=your_huggingface_token_here

# faster-whisperのモデルサイズ (tiny / base / small / medium / large-v3 など)
WHISPER_MODEL_SIZE=large-v3
# 実行デバイス (cpu / cuda)
WHISPER_DEVICE=cpu

# ==== 4. マルチエージェント討論・学習機能 ====
# 討論時に読み込む直近フィードバックの件数
DEBATE_FEEDBACK_CONTEXT_LIMIT=8
# 新規性判定を始めるまでの最低ラウンド数(これより前は必ず継続する)
DEBATE_MIN_ROUNDS_BEFORE_NOVELTY_CHECK=2
# 直近ラウンドの埋め込み類似度がこの値以上なら「新規性が収束した」とみなし、
# max_roundsに達していなくても討論を早期終了する(ASALの収束判定を参考)
DEBATE_NOVELTY_SIMILARITY_THRESHOLD=0.92

# ==== 5. 記憶圧縮システム(Neuro-Memory Architecture) ====
# 新皮質レイヤー(長期記憶)の埋め込みに使うOllamaモデル。事前に `ollama pull nomic-embed-text` が必要
OLLAMA_EMBED_MODEL=nomic-embed-text
# 海馬レイヤー(短期記憶)の生ログ保持日数。これを過ぎたエピソードは睡眠モードで統合後に削除される
MEMORY_RETENTION_DAYS=7
# 会話時に新皮質から呼び出す関連記憶の件数
MEMORY_RECALL_TOP_K=5
# 新皮質に既存メモリと類似度がこの値以上の新規メモリが来た場合、古い方をsuperseded(置き換え)扱いにする
MEMORY_SIMILARITY_THRESHOLD=0.85
# アバター解除判定で遡って見る会話履歴の日数(その日話した内容だけだと話題が集中しなかった場合に永久にチャンスを逃すため)
AVATAR_UNLOCK_LOOKBACK_DAYS=7

# ==== 6. 文学的感性コーパス(Aozora Bunko) ====
# 会話時に文学コーパスから呼び出すスタイルヒントの件数
LITERARY_HINT_TOP_K=2

# ==== 7. 夜間修行(Autonomous Study Loop) ====
# メンターAIとして使うGemini APIキー (https://aistudio.google.com/apikey で取得)
# 那由多さん自身のアカウント/課金になるため、未設定ならこの機能は動作しない(こっそり課金しない設計)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# 1トピックあたりの志粋⇔メンターの往復回数
STUDY_DIALOGUE_TURNS=3
# 1回の夜間修行で扱う弱点トピックの件数
STUDY_WEAK_TOPICS_COUNT=2

# ==== 9. モデルルーティング ====
# 質問内容(コーディング/推論/雑談)に応じて、その場で最適なローカルモデルへ振り分ける。
# 分類・振り分け先のモデルが未取得の場合は自動でOLLAMA_MODELにフォールバックする
MODEL_ROUTER_ENABLED=true
# 分類専用の軽量モデル。事前に `ollama pull qwen3:1.7b` が必要
# (Qwen3の実際のラインナップは0.6b/1.7b/4b/8b/14b/30b/32b/235bのみ。1.5b/7bは存在しない)
ROUTER_CLASSIFIER_MODEL=qwen3:1.7b
# コーディング・UI設計向け。事前に `ollama pull qwen3-coder:30b` が必要
ROUTER_CODING_MODEL=qwen3-coder:30b
# 論理的考察・推論向け。事前に `ollama pull deepseek-r1:8b` が必要
ROUTER_REASONING_MODEL=deepseek-r1:8b
# あいさつ・相槌など、深く考える必要が無いごく軽い一言向け。事前に `ollama pull qwen3:1.7b` が必要
ROUTER_SIMPLE_MODEL=qwen3:1.7b
# 内容のある雑談・軽い調べ物向け。事前に `ollama pull gemma2:9b` が必要
ROUTER_CHAT_MODEL=gemma2:9b

# ==== 10. 感情トーン検知 ====
# ユーザーの発言の感情(不安・落ち込み・苛立ち・上機嫌・平常)を毎ターン軽量モデルで
# 分類し、志粋の返答トーンに反映する。分類に失敗しても通常の会話は止まらない
# (フェイルオープン)。分類モデルはROUTER_CLASSIFIER_MODEL(またはGroq利用時は
# GROQ_CLASSIFIER_MODEL)を共用する。
EMOTION_DETECTION_ENABLED=true

# ==== 11. 自己修復プロトコル ====
# 会話中にエラーが起きた際、コーディング特化のモデルで修正案(diff)を自動生成する
# (use_groq時はGROQ_CODING_MODELを使う)。EVOLUTION_AUTO_APPLY=trueなら、
# テストが全件通った場合に限り人間の承認なしで自動適用・自動コミットする
# (失敗したパッチは作業ツリーを破棄し、何も適用しない)。falseにすると、
# 修正案の生成だけ行い、`python app.py evolution apply <id>`での人間承認が必須の
# 従来モードに戻る
EVOLUTION_ENABLED=true
EVOLUTION_FIX_MODEL=qwen3-coder:30b
EVOLUTION_AUTO_APPLY=true

# ==== 12. クラウド移行(Groq、Macの蓋を閉じても志粋が動けるようにする選択肢) ====
# trueにすると、chatの呼び出し(生成・モデル振り分け・ツール判定)をローカル
# Ollamaではなく Groqの無料枠APIへ向ける(docs/deploy_oracle.md参照)。
# 注意: embeddingは対象外(常にローカルOllama)。GroqのAPIキーではnomic-embed-text-v1_5に
# アクセスできないことを確認済み(src/common/embeddings.pyのコメント参照)
USE_GROQ=false
# console.groq.com で取得(無料・クレジットカード不要)
GROQ_API_KEY=your_groq_api_key_here
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant
GROQ_CODING_MODEL=qwen/qwen3.6-27b
GROQ_REASONING_MODEL=qwen/qwen3.6-27b
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
# GROQ_CHAT_MODELが1日あたりトークン上限(TPD)に達した時だけ、順に
# 切り替える先(モデルごとに独立したプールなので、まだ枠が残っていることが多い)
GROQ_FALLBACK_CHAT_MODEL=llama-3.3-70b-versatile
# 上記も枯渇した場合の3段目
GROQ_SECOND_FALLBACK_CHAT_MODEL=openai/gpt-oss-120b

# ==== 13. OpenRouter(コーディング質問だけ限定で使う無料枠) ====
# OpenRouterの無料枠(:freeモデル)は1日50〜1000リクエストとGroqよりかなり
# 少ないため、一般的な会話全体には向かない。コーディング質問だけ、より大きな
# モデル(Qwen3 Coder 480B、26万トークンの巨大コンテキスト)へ限定的に逃がす。
# 未設定(空文字列)なら従来通りOllama/Groqでコーディング質問も処理する。
# openrouter.ai でサインアップして取得(無料・クレジットカード不要)
OPENROUTER_API_KEY=
OPENROUTER_CODING_MODEL=qwen/qwen3-coder:free

# OpenRouter無料枠を使った「先輩AI」との夜間対話(自律討論・夜間修行(Gemini)とは別枠)。
# 上のOPENROUTER_API_KEYが未設定ならこの機能は自動的にスキップされる(必須ではない)。
# モデルタグはOpenRouter側の無料枠ラインナップ変更で404することがあるため、
# https://openrouter.ai/models?max_price=0 で有効なタグを確認のうえ必要なら差し替えること。
OPENROUTER_FREE_MENTOR_MODEL=deepseek/deepseek-r1:free
# 1トピックあたりの志粋⇔先輩AIの往復回数
EXTERNAL_DIALOGUE_TURNS=3

# ==== 14. 夜間トリガー(睡眠・自律学習・自律討論) ====
# 「夜眠っている間だけ学習している」というコンセプトに合わせ、以下の時間帯
# だけ睡眠モード・自律学習・自律討論が実行される
NIGHT_MODE_START_HOUR=23
NIGHT_MODE_END_HOUR=6
NIGHT_MODE_END_MINUTE=30
# サーバーを再起動しなくても夜間帯の開始を取りこぼさないための巡回間隔(秒)
NIGHT_MODE_CHECK_INTERVAL_SECONDS=600

# ==== 15. オーナー権限 ====
# この名前で登録されたユーザーだけが、自己修復提案の承認やフィードバック
# 一覧の閲覧などオーナー専用の操作を行える
OWNER_USER_NAME=那由多

# ==== 16. ニュース学習(Currents API、無料枠1日1000リクエスト) ====
# (1) 会話中にユーザーが求めたら今日のニュースを調べて紹介するツール、
# (2) 夜間修行で「社会」トピックとして時事ニュースも学ぶ、の両方で使う。
# 未設定(空文字列)ならどちらの機能も無効になる(必須ではない)。
# currentsapi.services でサインアップして取得(無料・クレジットカード不要)
CURRENTS_API_KEY=
# 夜間修行1回あたり、ニュースから追加するトピック数
STUDY_NEWS_TOPICS_COUNT=1

# ==== 17. 天気予報(Open-Meteo API、完全無料・APIキー不要) ====
# ユーザーが地名を指定しない場合や、地名からの位置特定に失敗した場合の既定地点
WEATHER_DEFAULT_LATITUDE=35.6762
WEATHER_DEFAULT_LONGITUDE=139.6503
WEATHER_DEFAULT_LOCATION_NAME=東京
